# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored: never commit it.
# On Azure, set the same names under App Service > Environment variables instead.

# AI summaries (already used before)
GOOGLE_API_KEY=

# Neon connection string from the Neon dashboard (Connect > Connection string).
# Use a SEPARATE Neon project for local testing and for the live site.
# Leave empty locally to use a throw-away SQLite file (local_dev.db) instead.
DATABASE_URL=

# Signs the login cookie. Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Recruiter sign-up needs this code. Leave empty to allow open sign-up.
RECRUITER_INVITE_CODE=

# Only used by seed_demo.py (the shared demo recruiter account)
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Demo Recruiter
DEMO_COMPANY=TalentMatch Demo
